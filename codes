import os
import warnings
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (ConfusionMatrixDisplay, accuracy_score,
    classification_report, f1_score, precision_score, recall_score,
    roc_auc_score, roc_curve)
from sklearn.model_selection import GridSearchCV, cross_val_score, train_test_split
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.tree import DecisionTreeClassifier

warnings.filterwarnings("ignore")
sns.set_theme(style="whitegrid")
RANDOM_STATE = 42
OUT_DIR = "outputs"
os.makedirs(OUT_DIR, exist_ok=True)

# ---------------- 1. Load data ----------------
df = pd.read_csv("loan_data.csv")
print(df.shape)
print(df.isnull().sum())

# ---------------- 2. Cleaning + feature engineering ----------------
df = df.drop(columns=["Loan_ID"])
df["Loan_Status"] = df["Loan_Status"].map({"Y": 1, "N": 0})
df["Dependents"] = df["Dependents"].replace("3+", "3")

df["TotalIncome"] = df["ApplicantIncome"] + df["CoapplicantIncome"]
df["LoanAmount_log"] = np.log1p(df["LoanAmount"])
df["TotalIncome_log"] = np.log1p(df["TotalIncome"])
df["EMI"] = df["LoanAmount"] * 1000 / df["Loan_Amount_Term"]
df["Balance_Income"] = df["TotalIncome"] - df["EMI"]

X = df.drop(columns=["Loan_Status"])
y = df["Loan_Status"]
X["Dependents"] = pd.to_numeric(X["Dependents"], errors="coerce")
X["Credit_History"] = X["Credit_History"].astype("object")

num_cols = ["ApplicantIncome", "CoapplicantIncome", "LoanAmount",
            "Loan_Amount_Term", "TotalIncome", "LoanAmount_log",
            "TotalIncome_log", "EMI", "Balance_Income", "Dependents"]
cat_cols = ["Gender", "Married", "Education", "Self_Employed",
            "Property_Area", "Credit_History"]

preprocess = ColumnTransformer([
    ("num", Pipeline([("imp", SimpleImputer(strategy="median")),
                      ("sc", StandardScaler())]), num_cols),
    ("cat", Pipeline([("imp", SimpleImputer(strategy="most_frequent")),
                      ("oh", OneHotEncoder(handle_unknown="ignore"))]), cat_cols),
])

# ---------------- 3. Graph 1: class distribution ----------------
fig, ax = plt.subplots(1, 2, figsize=(10, 4))
counts = y.map({1: "Approved", 0: "Rejected"}).value_counts()
sns.barplot(x=counts.index, y=counts.values,
            palette=["#2a9d8f", "#e76f51"], ax=ax[0])
ax[0].set_title("Class Distribution (Loan_Status)")
ax[0].set_ylabel("Applications")
ax[1].pie(counts.values, labels=counts.index, autopct="%1.1f%%",
          colors=["#2a9d8f", "#e76f51"], startangle=90)
ax[1].set_title("Approval Share")
plt.tight_layout()
plt.savefig(f"{OUT_DIR}/1_class_distribution.png", dpi=150)
plt.close()

# ---------------- 4. Train/test split ----------------
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=RANDOM_STATE)

# ---------------- 5. Models + tuning ----------------
models = {
    "Logistic Regression": (
        LogisticRegression(max_iter=1000, class_weight="balanced",
                           random_state=RANDOM_STATE),
        {"clf__C": [0.01, 0.1, 1, 10]}),
    "Decision Tree": (
        DecisionTreeClassifier(class_weight="balanced",
                               random_state=RANDOM_STATE),
        {"clf__max_depth": [3, 4, 5, 7],
         "clf__min_samples_leaf": [5, 10, 20]}),
    "Random Forest": (
        RandomForestClassifier(class_weight="balanced",
                               random_state=RANDOM_STATE),
        {"clf__n_estimators": [100, 300],
         "clf__max_depth": [4, 6, 8, None],
         "clf__min_samples_leaf": [2, 5]}),
}

results, fitted = [], {}
for name, (clf, grid) in models.items():
    pipe = Pipeline([("prep", preprocess), ("clf", clf)])
    search = GridSearchCV(pipe, grid, cv=5, scoring="roc_auc", n_jobs=-1)
    search.fit(X_train, y_train)
    best = search.best_estimator_
    fitted[name] = best

    pred = best.predict(X_test)
    proba = best.predict_proba(X_test)[:, 1]
    cv = cross_val_score(best, X_train, y_train, cv=5, scoring="accuracy")

    results.append({
        "Model": name,
        "Best Params": search.best_params_,
        "CV Accuracy": round(cv.mean(), 4),
        "Test Accuracy": round(accuracy_score(y_test, pred), 4),
        "Precision": round(precision_score(y_test, pred), 4),
        "Recall": round(recall_score(y_test, pred), 4),
        "F1": round(f1_score(y_test, pred), 4),
        "ROC-AUC": round(roc_auc_score(y_test, proba), 4),
    })
    print("\n===", name, "===")
    print("Best params:", search.best_params_)
    print(classification_report(y_test, pred,
                                target_names=["Rejected", "Approved"]))

res_df = pd.DataFrame(results).set_index("Model")
res_df.to_csv(f"{OUT_DIR}/model_comparison.csv")
print(res_df.drop(columns=["Best Params"]))

# ---------------- 6. Graph 2: confusion matrices ----------------
fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))
for ax, (name, model) in zip(axes, fitted.items()):
    ConfusionMatrixDisplay.from_estimator(
        model, X_test, y_test, display_labels=["Rejected", "Approved"],
        cmap="Blues", ax=ax, colorbar=False)
    ax.set_title(name)
    ax.grid(False)
plt.suptitle("Confusion Matrices (Test Set)")
plt.tight_layout()
plt.savefig(f"{OUT_DIR}/2_confusion_matrices.png", dpi=150)
plt.close()

# ---------------- 7. Graph 3: ROC curves ----------------
plt.figure(figsize=(7, 6))
for name, model in fitted.items():
    proba = model.predict_proba(X_test)[:, 1]
    fpr, tpr, _ = roc_curve(y_test, proba)
    plt.plot(fpr, tpr, lw=2,
             label=f"{name} (AUC = {roc_auc_score(y_test, proba):.3f})")
plt.plot([0, 1], [0, 1], "k--", label="Random guess")
plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("ROC Curves - Loan Approval")
plt.legend(loc="lower right")
plt.tight_layout()
plt.savefig(f"{OUT_DIR}/3_roc_curves.png", dpi=150)
plt.close()

# ---------------- 8. Graph 4: feature importance (Random Forest) ----------------
rf = fitted["Random Forest"]
names = rf.named_steps["prep"].get_feature_names_out()
imp = pd.Series(rf.named_steps["clf"].feature_importances_, index=names)
imp.index = [n.split("__", 1)[1] for n in imp.index]
imp = imp.sort_values().tail(12)
plt.figure(figsize=(8, 5))
imp.plot(kind="barh", color="#264653")
plt.title("Top Features - Random Forest")
plt.xlabel("Importance")
plt.tight_layout()
plt.savefig(f"{OUT_DIR}/4_feature_importance.png", dpi=150)
plt.close()

print("Done. Graphs and results saved in the outputs folder.")
